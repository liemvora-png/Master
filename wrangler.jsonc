{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-content",
      "database_id": "c8f201ef-8b43-49b7-8dc6-7bbc7c60f6f0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "portfolio-gallery"
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "old-shadow-43e8.cloudflareaccess.com",
    "ACCESS_AUD": "fac222eeb5ac4b2eda46a56ecc6be54d8186192f451046c03f7e2b87995a9cb7"
  }
}
