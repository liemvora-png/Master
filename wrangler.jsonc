{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-content",
      "database_id": "c8f201ef-8b43-49b7-8dc6-7bbc7c60f6f0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "portfolio-gallery"
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL"
    }
  ],
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubGllbXZvcmEuY2Mk",
    // Clerk signs every admin session token with this issuer, and publishes the
    // matching public keys at the JWKS url below.
    "CLERK_ISSUER": "https://clerk.liemvora.cc",
    "CLERK_JWKS_URL": "https://clerk.liemvora.cc/.well-known/jwks.json",
    // Clerk accounts allowed to edit the site. For more than one account use
    // CLERK_ADMIN_USER_IDS: "user_xxx,user_yyy". The admin editor shows the
    // rejected Clerk account id, which is what to put here.
    "CLERK_ADMIN_USER_ID": "user_3LHu9lXPwvZVoX3GEGv8qn85WEh"
  }
}
