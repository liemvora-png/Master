{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "master",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-content",
      "database_id": "c8f201ef-8b43-49b7-8dc6-7bbc7c60f6f0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "portfolio-gallery"
    }
  ],
  "send_email": [
    {
      "name": "BOOKING_EMAIL"
    }
  ],
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZGVsdGFnLnRlY2gk",
    "CLERK_ISSUER": "https://clerk.deltag.tech",
    "CLERK_JWKS_URL": "https://clerk.deltag.tech/.well-known/jwks.json",
    "CLERK_ADMIN_USER_ID": "user_3LHhoblyTQd373Y2LFWRZy4f5aJ"
  }
}
